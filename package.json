{
  "name": "secusim",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SecuSim 2.0: a sandbox for learning network topologies and security policies.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test",
    "check": "node --test && next lint",
    "simulate": "next build && next start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
